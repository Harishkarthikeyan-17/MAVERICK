# ─── Docker ignore ────────────────────────────────────────────────────────────
# Files and directories excluded from the Docker build context.
# Keeping this file lean speeds up builds and avoids leaking secrets.

# --- Node dependencies (reinstalled inside the image) -------------------------
node_modules
frontend/node_modules
backend-health/node_modules
backend/node_modules

# --- Git history (not needed in image) ----------------------------------------
.git
.gitignore

# --- Environment / secrets (injected at runtime via docker-compose / .env) ----
.env
.env.*
!.env.example

# --- Build artefacts (rebuilt inside the image) --------------------------------
# NOTE: we do NOT exclude frontend/dist globally — the frontend build stage
#       produces dist inside the image.  The line below prevents any locally
#       pre-built dist from being copied into Stage 2 accidentally.
frontend/dist
dist
build
.vite

# --- Python AI backend (not included in this deployment) ----------------------
backend/

# --- Python bytecode ----------------------------------------------------------
__pycache__
*.pyc
.venv
venv

# --- Logs ---------------------------------------------------------------------
*.log

# --- OS / editor artefacts ----------------------------------------------------
.DS_Store
Thumbs.db
*.swp
