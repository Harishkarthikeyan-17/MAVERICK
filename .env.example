# ─── MAVERICK — Environment Variable Template ─────────────────────────────────
# Copy this file to .env and fill in the real values before starting the stack.
# NEVER commit .env to version control (it is already in .gitignore).
#
# Usage:
#   cp .env.example .env
#   # edit .env with real values
#   docker compose up

# ─── Application ──────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 5000)
PORT=5000

# Public URL of the deployed application (used in password-reset emails)
# Example: https://app.yourdomain.com
APP_URL=http://localhost:3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Used by docker-compose to initialise the Postgres container AND by the app.
POSTGRES_DB=pulseai_auth
POSTGRES_USER=app_auth_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# These are the values the Express app reads (must match above in Docker)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pulseai_auth
DB_USER=app_auth_user
DB_PASSWORD=CHANGE_ME_strong_password

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Database name used by docker-compose and the application
MONGO_DATABASE=maverick
# Full connection URI — in Docker the hostname is the service name "mongo"
MONGODB_URI=mongodb://mongo:27017/maverick

# ─── Authentication ───────────────────────────────────────────────────────────
# Must be a long, random string (minimum 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_replace_with_long_random_secret_minimum_32_chars

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed in development.
# Leave empty in production (same-origin requests do not need CORS headers).
# Example: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Used by the password-reset feature (nodemailer via Gmail).
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password

# ─── AI / LLM API Keys ────────────────────────────────────────────────────────
# Groq — used by the AI assistant routes (finance chat, health chat, recipes …)
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini — used ONLY by backend-health (server-side). Never exposed to the browser.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
